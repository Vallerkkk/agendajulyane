# Agenda da Julyane — variáveis de ambiente (Render → Environment)
# Copie os valores do projeto novo. Nenhum valor real deve ser versionado.

# Banco (Supabase → Project Settings → API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=SUA_SECRET_KEY

# Sessão do painel (qualquer texto longo e aleatório)
SESSION_SECRET=troque-por-uma-frase-longa-e-aleatoria

# Endereço público do app no Render (usado nos e-mails, SMS e push)
SITE_URL=https://agendajulyane.onrender.com

# Notificações push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:agenda@julyane.local

# Token que o agendador externo envia no cabeçalho x-agenda-token
CRON_TOKEN=troque-por-um-token-longo

# E-mail e SMS pela Brevo (plano gratuito do Render bloqueia SMTP)
# EMAIL_PARA recebe o resumo diário e os avisos (o agendador chama
# /api/despacho às 07:00 de Brasília, todos os dias)
BREVO_API_KEY=
EMAIL_DESDE=conta-verificada@exemplo.com
EMAIL_PARA=conta-verificada@exemplo.com
SMS_PARA=27999999999
SMS_REMETENTE=Julyane

# Alternativa de e-mail por SMTP (opcional; só funciona em plano pago)
SMTP_HOST=
SMTP_PORT=465
SMTP_USUARIO=
SMTP_SENHA=
